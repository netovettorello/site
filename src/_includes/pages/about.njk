{%- set t = i18n[lang] -%}
{%- macro cvlist(items, lang) -%}
<ol class="cv">
  {%- for e in items %}
  <li><span class="cv-year">{{ e.year }}</span><span>{% if e.url %}<a class="link" href="{{ e.url }}" target="_blank" rel="noopener">{{ e[lang] }}</a>{% else %}{{ e[lang] }}{% endif %}</span></li>
  {%- endfor %}
</ol>
{%- endmacro -%}
<section class="page-head">
  <h1>{{ t.about_title }}</h1>
</section>
<section class="about">
  <figure class="about-portrait"><img src="{{ about.portrait | img(1000) }}" alt="Neto Vettorello"></figure>
  <div class="about-text">
    {{ (about.bio_pt if lang == 'pt' else about.bio_en) | paras | safe }}
    <p class="actions"><a class="button" href="{{ site.portfolio_pdf | u }}" download>{{ t.download_pdf }}</a></p>
  </div>
</section>
<section class="cv-grid">
  <div>
    <h2>{{ t.awards }}</h2>
    {{ cvlist(about.awards, lang) }}
    <p class="cv-more"><a class="label-link" href="{{ ('/' + lang + '/' + t.path_exhibitions + '/') | u }}">{{ t.see_exhibitions }} →</a></p>
  </div>
  <div class="cv-span">
    <h2>{{ t.talks }}</h2>
    {{ cvlist(about.talks, lang) }}
  </div>
</section>

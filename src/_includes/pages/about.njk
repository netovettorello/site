{%- set t = i18n[lang] -%}
{%- macro cvlist(items, lang) -%}
<ol class="cv cv--cols">
  {%- for e in items %}
  <li><span class="cv-year">{{ e.year }}</span><span>{% if e.url %}<a class="link" href="{{ e.url }}" target="_blank" rel="noopener">{{ e[lang] }}</a>{% else %}{{ e[lang] }}{% endif %}</span></li>
  {%- endfor %}
</ol>
{%- endmacro -%}
<section class="page-head wrap">
  <h1>{{ t.about_title }}</h1>
</section>
<section class="about wrap">
  <figure class="about-portrait" data-reveal><img src="{{ about.portrait | img(1000) }}" alt="Neto Vettorello"></figure>
  <div class="about-text prose">
    {{ (about.bio_pt if lang == 'pt' else about.bio_en) | paras | safe }}
    <p class="actions"><a class="btn btn--ghost" href="{{ site.portfolio_pdf | u }}" download>{{ t.download_pdf }}</a></p>
  </div>
</section>
<section class="sec wrap cv-block">
  <h2>{{ t.awards }}</h2>
  {{ cvlist(about.awards, lang) }}
</section>
<section class="sec wrap cv-block">
  <h2>{{ t.exhibitions }}</h2>
  <ol class="cv cv--cols">
    {%- for e in about.exhibitions %}{% if e.kind != 'mural' %}
    <li><span class="cv-year">{{ e.year }}</span><span>{% if e.page %}<a class="link" href="{{ ('/' + lang + '/' + t.path_exhibitions + '/' + e.page + '/') | u }}">{{ e[lang] }}</a>{% elif e.url %}<a class="link" href="{{ e.url }}" target="_blank" rel="noopener">{{ e[lang] }}</a>{% else %}{{ e[lang] }}{% endif %}</span></li>
    {%- endif %}{% endfor %}
  </ol>
</section>
<section class="sec wrap cv-block">
  <h2>{{ t.talks }}</h2>
  {{ cvlist(about.talks, lang) }}
</section>
{% include "closing.njk" %}

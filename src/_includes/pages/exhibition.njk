{%- set t = i18n[lang] -%}
{%- import "cards.njk" as cards -%}
{%- set e = exposicoes[slug] -%}
{%- set base = '/' + lang + '/' + t.path_exhibitions + '/' -%}
{%- set country = e['country_' + lang] -%}
{%- set txt = e['text_' + lang] -%}
<article class="detail">
  <header class="detail-head wrap">
    <a class="back" href="{{ base | u }}">{% include "chev.svg" %}{{ t.back_exhibitions }}</a>
    <h1>{{ e.title }}</h1>
    <p class="detail-sub">{{ e['type_' + lang] }}</p>
  </header>

  <div class="show wrap">
    <div class="show-text">
      <dl class="rows">
        <div><dt>{{ t.s_place }}</dt><dd>{{ e.venue }}, {{ e.city }}{% if country %}, {{ country }}{% endif %}</dd></div>
        {% if e.year %}<div><dt>{{ t.s_year }}</dt><dd>{{ e.year }}</dd></div>{% endif %}
      </dl>
      {% if txt %}<div class="prose">{{ txt | paras | safe }}</div>{% endif %}
      <p class="actions">
        <a class="btn" href="{{ ('/' + lang + '/' + t.path_contact + '/') | u }}?tipo=exposicao&amp;ref={{ e.title | enc }}">{{ t.project_enquire }}</a>
        {% if e.link %}<a class="btn btn--ghost" href="{{ e.link }}" target="_blank" rel="noopener">{{ t.visit_site }}</a>{% endif %}
      </p>
    </div>
    <div class="show-media">
      {%- for src in e.images %}
      <button class="zoom" type="button" data-zoom="{{ src | img(2400) }}" aria-label="{{ t.view_larger }}: {{ e.title }}"><img src="{{ src | img(1600) }}" alt="{{ e.title }}" {{ src | wh | safe }}{% if not loop.first %} loading="lazy"{% endif %}></button>
      {%- endfor %}
    </div>
  </div>
</article>

{% if e.works and e.works.length %}
<section class="sec wrap">
  <div class="head"><h2>{{ t.works_in_show }}</h2></div>
  <div class="grid-art grid-art--4">
    {%- for s in e.works %}{% set w = obras[s] %}{% if w %}
    {{ cards.art(w, s, lang, t, ('/' + lang + '/' + t.path_works + '/' + s + '/') | u, w.images[0] | img(800)) }}
    {%- endif %}{% endfor %}
  </div>
</section>
{% endif %}

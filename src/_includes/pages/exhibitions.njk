{%- set t = i18n[lang] -%}
{%- import "cards.njk" as cards -%}
<section class="page-head wrap">
  <h1>{{ t.nav_exhibitions }}</h1>
  <p class="page-intro">{{ t.exhibitions_intro }}</p>
</section>
<section class="wrap list">
  <div class="features">
    {%- for e in exposicoes | sorted %}
    {{ cards.feature(e, lang, t, ('/' + lang + '/' + t.path_exhibitions + '/' + e.slug + '/') | u, e.images[0] | img(1600)) }}
    {%- endfor %}
  </div>
</section>
{% include "closing.njk" %}

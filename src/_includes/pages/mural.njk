{%- set t = i18n[lang] -%}
{%- set m = murais[slug] -%}
{%- set list = murais | sorted -%}
{%- set nb = list | neighbours(slug) -%}
{%- set base = '/' + lang + '/' + t.path_murals + '/' -%}
{%- set country = m['country_' + lang] -%}
{%- set client = ((m.client if lang == 'pt' else (m.client_en or m.client)) or '') | replace(' · ', ', ') -%}
{%- set dims = ((m.dimensions or '') | replace(',', '.')) if lang == 'en' else m.dimensions -%}
{%- set txt = m['text_' + lang] -%}
<article class="detail">
  <header class="detail-head wrap">
    <a class="back" href="{{ base | u }}">{% include "chev.svg" %}{{ t.back_murals }}</a>
    <h1>{{ m.title }}</h1>
    <p class="detail-sub">{{ m.city }}{% if country %}, {{ country }}{% endif %}</p>
  </header>

  <div class="wrap">
    <figure class="detail-hero" style="view-transition-name:m-{{ slug }}"><img src="{{ m.images[0] | img(2400) }}" alt="{{ m.title }}" fetchpriority="high"></figure>
  </div>

  <div class="detail-body wrap">
    <dl class="specs">
      {% if m.year %}<div><dt>{{ t.s_year }}</dt><dd>{{ m.year }}</dd></div>{% endif %}
      <div><dt>{{ t.s_place }}</dt><dd>{{ m.city }}{% if country %}, {{ country }}{% endif %}</dd></div>
      {% if client %}<div><dt>{{ t.s_client }}</dt><dd>{{ client }}</dd></div>{% endif %}
      {% if dims %}<div><dt>{{ t.s_size }}</dt><dd>{{ dims }}</dd></div>{% endif %}
    </dl>
    {% if txt %}<div class="prose detail-text">{{ txt | paras | safe }}</div>{% endif %}
    <p class="actions">
      <a class="btn" href="{{ ('/' + lang + '/' + t.path_contact + '/') | u }}?tipo=mural&amp;ref={{ m.title | enc }}">{{ t.project_enquire }}</a>
      {% if m.vimeo %}<a class="btn btn--ghost" href="https://vimeo.com/{{ m.vimeo }}" target="_blank" rel="noopener"><svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true"><path fill="currentColor" d="M3 1.6v8.8a.6.6 0 0 0 .9.5l7-4.4a.6.6 0 0 0 0-1L3.9 1.1a.6.6 0 0 0-.9.5z"/></svg>{{ t.watch_video }}</a>{% endif %}
    </p>
  </div>

  {%- if m.images.length > 1 %}
  <div class="gallery wrap">
    {%- for src in m.images %}{% if not loop.first %}
    <img src="{{ src | img(1800) }}" alt="{{ m.title }} ({{ loop.index }})" loading="lazy" decoding="async" data-reveal>
    {%- endif %}{% endfor %}
  </div>
  {%- endif %}
</article>

<section class="wrap next-wrap">
  <a class="next" href="{{ (base + nb.next.slug + '/') | u }}" style="view-transition-name:m-{{ nb.next.slug }}">
    <img src="{{ nb.next.images[0] | img(1800) }}" alt="" loading="lazy" decoding="async" data-parallax>
    <span class="next-cap">
      <span class="next-label">{{ t.next_mural }}</span>
      <span class="next-title">{{ nb.next.title }}</span>
    </span>
  </a>
</section>

{%- set t = i18n[lang] -%}
{%- import "cards.njk" as cards -%}
{%- set allMurals = murais | sorted -%}
{%- set allWorks = obras | sorted -%}
{%- set muralsUrl = '/' + lang + '/' + t.path_murals + '/' -%}
{%- set worksUrl = '/' + lang + '/' + t.path_works + '/' -%}
{%- set showsUrl = '/' + lang + '/' + t.path_exhibitions + '/' -%}
{%- set aboutUrl = '/' + lang + '/' + t.path_about + '/' -%}
{%- set resistanceUrl = worksUrl + 'resistencia/' -%}
<section class="hero nv-hero" aria-label="{{ site.name }}">
  <div class="hero-stick">
    <div class="hero-frame nv-hero-frame">
      <div class="hero-slides">
        {% for h in site.hero %}<img class="hero-media{% if loop.first %} on{% endif %}" src="{{ h.image | img(2400) }}" alt="{{ h.caption }}" data-cap="{{ h.caption }}" {% if loop.first %}fetchpriority="high"{% endif %} decoding="async">{% endfor %}
      </div>
    </div>

    <div class="nv-hero-layout">
      <div class="nv-hero-copy" data-reveal>
        <h1 class="nv-hero-headline" aria-label="Neto Vettorello"><span class="nv-title-one">Neto</span><span class="nv-title-two">Vettorello</span></h1>
        <p class="nv-hero-profession">{{ "Visual artist · Public art, painting, sculpture & installation" if lang == "en" else "Artista visual · Arte pública, pintura, escultura e instalação" }}</p>
      </div>

      <div class="nv-hero-bottom" data-reveal>
        <div class="nv-hero-dossier">
          <strong>{{ "Selected works & projects" if lang == "en" else "Obras e projetos selecionados" }}</strong>
          <span>{{ "A curated overview of murals, artworks and site-specific practice." if lang == "en" else "Um panorama curado entre murais, obras e prática site-specific." }}</span>
        </div>

        <div class="nv-hero-nav" aria-label="{{ 'Featured projects' if lang == 'en' else 'Projetos em destaque' }}">
          <div class="nv-hero-caption" data-nv-caption>{{ site.hero[0].caption }}</div>
          <div class="nv-hero-progress"><span class="nv-progress-current" data-nv-current>01</span><div class="nv-progress-bar"><span data-nv-progress-fill></span></div><span class="nv-progress-total">0{{ site.hero.length }}</span></div>
          <div class="nv-hero-dots" data-nv-dots>
            {% for h in site.hero %}<button type="button" class="nv-dot{% if loop.first %} is-active{% endif %}" aria-label="{{ h.caption }}" data-index="{{ loop.index0 }}"></button>{% endfor %}
          </div>
        </div>

        <a href="#nv-curated" class="nv-scroll-cue" aria-label="{{ 'Explore works' if lang == 'en' else 'Explorar obras' }}">{{ 'DISCOVER' if lang == 'en' else 'DESCOBRIR' }}<span>↘</span></a>
      </div>
    </div>
  </div>
</section>

<section class="nv-manifesto" aria-label="{{ 'Practice overview' if lang == 'en' else 'Visão geral da prática' }}">
  <span class="nv-micro" data-reveal>{{ "PRACTICE" if lang == "en" else "PRÁTICA" }}</span>
  <div class="nv-manifesto-content">
    <h2 class="nv-manifesto-copy" data-reveal>{{ "A visual practice built across public space, original works and commissioned projects." if lang == "en" else "Uma prática visual construída entre espaço público, obras autorais e projetos comissionados." }}</h2>
    <p class="nv-manifesto-description" data-reveal>{{ "From murals and paintings to sculpture and installation, each project is shaped by scale, context and a distinct visual language." if lang == "en" else "De murais e pinturas a esculturas e instalações, cada projeto é conduzido por escala, contexto e uma linguagem visual própria." }}</p>
  </div>
  <a class="nv-manifesto-link" href="#nv-curated" data-reveal>{{ "VIEW SELECTED WORKS" if lang == "en" else "VER OBRAS SELECIONADAS" }} ↘</a>
</section>

<section class="nv-curated" id="nv-curated" aria-label="{{ 'Selected works' if lang == 'en' else 'Obras selecionadas' }}">
  <div class="nv-curated-heading" data-reveal><h2>{{ "Selected works" if lang == "en" else "Obras selecionadas" }}</h2><p>{{ "A concise selection across murals, paintings and sculptural thinking." if lang == "en" else "Uma seleção concisa entre murais, pinturas e pensamento escultórico." }}</p></div>
  <div class="nv-immersive-rail" data-immersive-rail>
    <a href="{{ muralsUrl | u }}" class="nv-immersive-card" data-reveal><img src="/img/portal.jpg" alt="The Portal — mural" loading="lazy"><span class="nv-immersive-meta"><b>THE PORTAL</b><small>WATERFORD — 2023</small></span></a>
    <a href="{{ resistanceUrl | u }}" class="nv-immersive-card" data-reveal><img src="/img/resistencia/resistencia-series-mark.png" alt="{{ 'Resistance Series' if lang == 'en' else 'Série Resistência' }}" loading="lazy"><span class="nv-immersive-meta"><b>{{ "RESISTANCE SERIES" if lang == "en" else "SÉRIE RESISTÊNCIA" }}</b><small>2026</small></span></a>
    <a href="{{ worksUrl | u }}" class="nv-immersive-card" data-reveal><img src="/img/tani-e.jpg" alt="Tani É" loading="lazy"><span class="nv-immersive-meta"><b>TANI É</b><small>{{ "VISUAL LANGUAGE" if lang == "en" else "LINGUAGEM VISUAL" }}</small></span></a>
    <a href="{{ muralsUrl | u }}" class="nv-immersive-card" data-reveal><img src="/img/into-the-reef.jpg" alt="Into the Reef" loading="lazy"><span class="nv-immersive-meta"><b>INTO THE REEF</b><small>CORK — 2025</small></span></a>
  </div>
  <div class="nv-rail-footer" data-reveal><span>{{ "Drag or scroll to navigate" if lang == "en" else "Arraste ou role para navegar" }}</span><div class="nv-rail-actions"><button type="button" data-nv-prev aria-label="Previous artwork">←</button><button type="button" data-nv-next aria-label="Next artwork">→</button></div></div>
</section>

<section class="nv-resistance wrap" aria-label="{{ 'Resistance series' if lang == 'en' else 'Série Resistência' }}">
  <div class="nv-resistance-head">
    <div data-reveal>
      <span class="nv-resistance-kicker">{{ "SERIES" if lang == "en" else "SÉRIE" }}</span>
      <h2>{{ "Resistance" if lang == "en" else "Resistência" }}</h2>
    </div>
    <div class="nv-resistance-intro" data-reveal>
      <p>{{ "A 2026 series of works in which Tani É confronts authoritarianism, political violence and social tension through protest, memory and symbolic presence." if lang == "en" else "Uma série de 2026 em que Tani É confronta o autoritarismo, a violência política e a tensão social por meio de protesto, memória e presença simbólica." }}</p>
      <a class="btn btn--ghost nv-resistance-link" href="{{ resistanceUrl | u }}">{{ "VIEW THE SERIES" if lang == "en" else "VER A SÉRIE" }} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="nv-resistance-grid">
    <a href="{{ resistanceUrl | u }}" class="nv-resistance-card nv-resistance-card--lead" data-reveal><img src="/img/resistencia/resistencia-molotov.png" alt="Resistance series — Molotov work" loading="lazy"></a>
    <a href="{{ resistanceUrl | u }}" class="nv-resistance-card" data-reveal><img src="/img/resistencia/resistencia-bleeding-flag.png" alt="Resistance series — bleeding flag work" loading="lazy"></a>
    <a href="{{ resistanceUrl | u }}" class="nv-resistance-card" data-reveal><img src="/img/resistencia/resistencia-palestine.png" alt="Resistance series — Palestine work" loading="lazy"></a>
    <a href="{{ resistanceUrl | u }}" class="nv-resistance-card" data-reveal><img src="/img/resistencia/resistencia-sign.png" alt="Resistance series — sign work" loading="lazy"></a>
  </div>
</section>

<section class="statement wrap">
  <div class="statement-index" data-reveal><span>{{ "ABOUT THE ARTIST" if lang == "en" else "SOBRE O ARTISTA" }}</span></div>
  <div class="nv-statement-layout"><h2 class="nv-statement-title" data-reveal>{{ "A multidisciplinary practice with a distinct visual language." if lang == "en" else "Uma prática multidisciplinar com linguagem visual própria." }}</h2><div class="nv-statement-content"><p class="statement-text" data-reveal>{{ t.intro }}</p><a class="btn btn--ghost nv-statement-cta" href="{{ aboutUrl | u }}" data-reveal>{{ "EXPLORE THE PRACTICE" if lang == "en" else "CONHEÇA O ARTISTA" }} <span aria-hidden="true">↗</span></a></div></div>
</section>

<section class="sec section-numbered" style="--section-n:'02'">
  <div class="head wrap" data-reveal>
    <h2>{{ t.nav_murals }}</h2>
    <a class="more" href="{{ muralsUrl | u }}">{{ t.all_murals }}{% include "chev.svg" %}</a>
  </div>
  <div class="rail" data-rail>
    <div class="rail-track">
      {%- for m in allMurals | top(6) %}
      {{ cards.shot(m, m.slug, lang, (muralsUrl + m.slug + '/') | u, m.images[0] | img(1800)) }}
      {%- endfor %}
    </div>
    <div class="rail-nav wrap" hidden>
      <button class="paddle" type="button" data-dir="-1" aria-label="{{ t.prev }}">{% include "chev.svg" %}</button>
      <button class="paddle" type="button" data-dir="1" aria-label="{{ t.next }}">{% include "chev.svg" %}</button>
    </div>
  </div>
</section>

{%- set scaled = allMurals | toScale(5) %}
{%- if scaled.length > 1 %}
<section class="sec wrap">
  <div class="tile scale" data-reveal>
    <div class="scale-head">
      <h2>{{ t.scale_title }}</h2>
      <p>{{ t.scale_text }}</p>
    </div>
    <div class="scale-scroll">
      <ol class="scale-list">
        {%- for m in scaled %}
        <li style="--w:{{ m.pct }}%;--ar:{{ m.ar }};--person:{{ m.person }}%;--i:{{ loop.index0 }}">
          <a href="{{ (muralsUrl + m.slug + '/') | u }}">
            <span class="scale-bar"><img src="{{ m.images[0] | img(2000) }}" alt="" loading="lazy" decoding="async" style="object-position:50% {{ m.focus if m.focus is defined else 50 }}%"><svg class="scale-person" viewBox="0 0 10 28" aria-hidden="true"><circle cx="5" cy="3" r="2.7"/><path d="M1 9.4a2.8 2.8 0 0 1 2.8-2.8h2.4A2.8 2.8 0 0 1 9 9.4v7.4H7.5V28h-2v-9h-1v9h-2V16.8H1z"/></svg></span>
            <span class="scale-cap"><span class="scale-name">{{ m.title }}</span><span class="scale-dim">{{ (m.dimensions | replace(',', '.')) if lang == 'en' else m.dimensions }}</span></span>
          </a>
        </li>
        {%- endfor %}
      </ol>
    </div>
  </div>
</section>
{%- endif %}

<section class="sec section-numbered" style="--section-n:'04'">
  <div class="head wrap" data-reveal>
    <h2>{{ t.nav_works }}</h2>
    <a class="more" href="{{ worksUrl | u }}">{{ t.all_works }}{% include "chev.svg" %}</a>
  </div>
  <div class="bento wrap">
    {%- for w in allWorks | bento %}
    {{ cards.art(w, w.slug, lang, t, (worksUrl + w.slug + '/') | u, w.images[0] | img(1200), 'art--' + w.slot) }}
    {%- endfor %}
  </div>
</section>

{%- set shows = exposicoes | sorted | featured %}
{%- if shows.length %}
<section class="sec wrap">
  <div class="head" data-reveal>
    <h2>{{ t.nav_exhibitions }}</h2>
    <a class="more" href="{{ showsUrl | u }}">{{ t.see_exhibitions }}{% include "chev.svg" %}</a>
  </div>
  <div class="features">
    {%- for e in shows %}
    {{ cards.feature(e, lang, t, (showsUrl + e.slug + '/') | u, e.images[0] | img(1600)) }}
    {%- endfor %}
  </div>
</section>
{%- endif %}

<section class="sec wrap clients">
  <h2 data-reveal>{{ t.clients }}</h2>
  <img class="clients-img" src="{{ site.clients_image | img(2000) }}" alt="{{ site.clients_alt }}" loading="lazy" decoding="async" width="2000" height="957" data-reveal>
</section>

{% include "closing.njk" %}

{%- set t = i18n[lang] -%}
{%- import "cards.njk" as cards -%}
{%- set allMurals = murais | sorted -%}
{%- set allWorks = obras | sorted -%}
{%- set muralsUrl = '/' + lang + '/' + t.path_murals + '/' -%}
{%- set worksUrl = '/' + lang + '/' + t.path_works + '/' -%}
{%- set showsUrl = '/' + lang + '/' + t.path_exhibitions + '/' -%}
{%- set aboutUrl = '/' + lang + '/' + t.path_about + '/' -%}
{%- set resistanceUrl = worksUrl + 'resistencia/' -%}
<section class="hero nv-hero" aria-label="{{ site.name }}">
  <div class="hero-stick">
    <div class="hero-frame nv-hero-frame">
      <div class="hero-slides">
        {% for h in site.hero %}<img draggable="false" class="hero-media{% if loop.first %} on{% endif %}" src="{{ h.image | img(2400) }}" alt="{{ h.caption }}" data-cap="{{ h.caption }}" {% if loop.first %}fetchpriority="high"{% endif %} decoding="async">{% endfor %}
      </div>
    </div>

    <div class="nv-hero-layout">
      <div class="nv-hero-copy">
        <h1 class="nv-hero-headline" aria-label="Neto Vettorello" data-reveal><span class="nv-title-one">Neto</span><span class="nv-title-two">Vettorello</span></h1>
        <p class="nv-hero-profession" data-reveal>{{ "Visual artist · Public art, painting, sculpture & installation" if lang == "en" else "Artista visual · Arte pública, pintura, escultura e instalação" }}</p>
      </div>

      <button class="nv-hero-arrow nv-hero-arrow--prev" type="button" data-nv-slide-prev aria-label="{{ 'Previous artwork' if lang == 'en' else 'Obra anterior' }}"><svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path d="m14 5-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <button class="nv-hero-arrow nv-hero-arrow--next" type="button" data-nv-slide-next aria-label="{{ 'Next artwork' if lang == 'en' else 'Próxima obra' }}"><svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path d="m10 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>

      <div class="nv-hero-bottom">
        <div class="nv-carousel-ui" role="group" aria-label="{{ 'Artwork slideshow controls' if lang == 'en' else 'Controles do carrossel de obras' }}">
          <div class="nv-carousel-pill" data-nv-controls>
            <button class="nv-carousel-step" type="button" data-nv-slide-prev-bottom aria-label="{{ 'Previous artwork' if lang == 'en' else 'Obra anterior' }}"><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="m14 5-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            <div class="nv-carousel-dots" data-nv-dots>
              {% for h in site.hero %}<button type="button" class="nv-carousel-dot{% if loop.first %} is-active{% endif %}" data-index="{{ loop.index0 }}" aria-label="{{ 'Go to slide' if lang == 'en' else 'Ir para imagem' }} {{ loop.index }}" aria-current="{{ 'true' if loop.first else 'false' }}"><span class="nv-carousel-track"><span class="nv-carousel-fill"></span></span></button>{% endfor %}
            </div>
            <button class="nv-carousel-step" type="button" data-nv-slide-next-bottom aria-label="{{ 'Next artwork' if lang == 'en' else 'Próxima obra' }}"><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="m10 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          </div>
          <button class="nv-carousel-toggle" data-nv-autoplay type="button" aria-label="{{ 'Pause slideshow' if lang == 'en' else 'Pausar apresentação' }}" aria-pressed="true" title="{{ 'Pause slideshow' if lang == 'en' else 'Pausar apresentação' }}">
            <svg class="nv-icon-pause" viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor"/><rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor"/></svg>
            <svg class="nv-icon-play" viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path d="M7 4.7a1.2 1.2 0 0 1 1.85-1.01l11 7.3a1.2 1.2 0 0 1 0 2.02l-11 7.3A1.2 1.2 0 0 1 7 19.3V4.7Z" fill="currentColor"/></svg>
          </button>
        </div>
        <a href="#nv-curated" class="nv-scroll-cue" aria-label="{{ 'Explore works' if lang == 'en' else 'Explorar obras' }}">{{ 'EXPLORE' if lang == 'en' else 'EXPLORAR' }}<span aria-hidden="true">↓</span></a>
      </div>
      <div class="nv-slide-live sr-only" aria-live="polite" data-nv-live></div>
    </div>
  </div>
</section>

<section class="nv-curated" id="nv-curated" aria-label="{{ 'Selected works' if lang == 'en' else 'Obras selecionadas' }}">
  <div class="nv-curated-heading" data-reveal><h2>{{ "Selected works" if lang == "en" else "Obras selecionadas" }}</h2></div>
  <div class="nv-immersive-rail" data-immersive-rail tabindex="0" aria-label="{{ 'Selected projects. Use arrow keys or controls to browse.' if lang == 'en' else 'Projetos em destaque. Use as setas do teclado ou os controles para navegar.' }}">
    <a href="{{ (muralsUrl + 'the-portal/') | u }}" class="nv-immersive-card" data-reveal><img src="{{ '/img/portal.jpg' | img(1600) }}" alt="The Portal — mural" loading="lazy"><span class="nv-immersive-meta"><b>THE PORTAL</b><small>WATERFORD — 2023</small></span></a>
    <a href="{{ resistanceUrl | u }}" class="nv-immersive-card" data-reveal><img src="{{ '/img/resistencia/resistencia-headdress.png' | img(1250) }}" alt="{{ 'Resistance Series' if lang == 'en' else 'Série Resistência' }}" loading="lazy"><span class="nv-immersive-meta"><b>{{ "RESISTANCE SERIES" if lang == "en" else "SÉRIE RESISTÊNCIA" }}</b><small>2026</small></span></a>
    <a href="{{ ('/' + lang + '/tani-e/') | u }}" class="nv-immersive-card" data-reveal><img src="{{ '/img/tani-e.jpg' | img(1600) }}" alt="Tani É" loading="lazy"><span class="nv-immersive-meta"><b>TANI É</b><small>{{ "VISUAL LANGUAGE" if lang == "en" else "LINGUAGEM VISUAL" }}</small></span></a>
    <a href="{{ (muralsUrl + 'into-the-reef/') | u }}" class="nv-immersive-card" data-reveal><img src="{{ '/img/into-the-reef.jpg' | img(1600) }}" alt="Into the Reef" loading="lazy"><span class="nv-immersive-meta"><b>INTO THE REEF</b><small>CORK — 2025</small></span></a>
  </div>
  <div class="nv-rail-footer" data-reveal><div class="nv-rail-actions"><button type="button" data-nv-prev aria-label="Previous artwork">←</button><button type="button" data-nv-next aria-label="Next artwork">→</button></div></div>
</section>

<section class="nv-resistance wrap" aria-label="{{ 'Resistance series' if lang == 'en' else 'Série Resistência' }}">
  <div class="nv-resistance-head" data-reveal>
    <div class="nv-resistance-heading">
      <span class="nv-resistance-kicker">{{ "SERIES · 2026" if lang == "en" else "SÉRIE · 2026" }}</span>
      <h2>{{ "Resistance" if lang == "en" else "Resistência" }}</h2>
      <p class="nv-resistance-summary">{{ "Through Tani É, thirteen original works on paper confront authoritarianism, political violence and the question of how we respond to injustice." if lang == "en" else "Por meio de Tani É, treze obras originais sobre papel confrontam o autoritarismo, a violência política e nossa resposta diante da injustiça." }}</p>
    </div>
    <a class="btn btn--ghost nv-resistance-link" href="{{ resistanceUrl | u }}">{{ "EXPLORE THE SERIES" if lang == "en" else "EXPLORAR A SÉRIE" }} <span aria-hidden="true">↗</span></a>
  </div>
  <div class="nv-resistance-carousel" data-resistance-carousel role="region" aria-roledescription="carousel" aria-label="{{ 'Resistance series — five works' if lang == 'en' else 'Série Resistência — cinco obras' }}">
    <div class="nv-resistance-track" data-resistance-track tabindex="0" aria-label="{{ 'Swipe or use arrows to explore the artworks' if lang == 'en' else 'Deslize ou use as setas para explorar as obras' }}">
      {% set resistanceImages = [
        {"src":"/img/resistencia/resistencia-molotov.png", "pt":"Obra com coquetel molotov", "en":"Molotov artwork"},
        {"src":"/img/resistencia/resistencia-bleeding-flag.png", "pt":"Bandeira que sangra", "en":"Bleeding flag"},
        {"src":"/img/resistencia/resistencia-palestine.png", "pt":"Obra com bandeira palestina", "en":"Palestinian flag artwork"},
        {"src":"/img/resistencia/resistencia-sign.png", "pt":"Cartaz de protesto", "en":"Protest sign artwork"},
        {"src":"/img/resistencia/resistencia-headdress.png", "pt":"Resistência dos povos originários", "en":"Indigenous resistance artwork"}
      ] %}
      {% for artwork in resistanceImages %}
      <button class="nv-resistance-slide" type="button" data-resistance-image="{{ artwork.src | u }}" aria-label="{{ 'View artwork enlarged' if lang == 'en' else 'Ampliar obra' }}: {{ artwork[lang] }}" data-resistance-label="{{ artwork[lang] }}">
        <img src="{{ artwork.src | img(1100) }}" alt="{{ artwork[lang] }}" loading="lazy" decoding="async" draggable="false">
        <span class="nv-resistance-zoom" aria-hidden="true">↗</span>
      </button>
      {% endfor %}
    </div>
    <div class="nv-resistance-controls">
      <div class="nv-resistance-indicators" data-resistance-indicators aria-label="{{ 'Select artwork' if lang == 'en' else 'Selecionar obra' }}">
        {% for i in [1,2,3,4,5] %}<button type="button" data-resistance-go="{{ loop.index0 }}" aria-label="{{ 'Go to artwork' if lang == 'en' else 'Ir para obra' }} {{ i }}" aria-current="{{ 'true' if loop.first else 'false' }}"><span></span></button>{% endfor %}
      </div>
      <div class="nv-resistance-actions">
        <button type="button" data-resistance-prev aria-label="{{ 'Previous artwork' if lang == 'en' else 'Obra anterior' }}" disabled>←</button>
        <button type="button" data-resistance-next aria-label="{{ 'Next artwork' if lang == 'en' else 'Próxima obra' }}">→</button>
      </div>
    </div>
  </div>
  <dialog class="nv-resistance-lightbox" data-resistance-lightbox aria-label="{{ 'Artwork detail' if lang == 'en' else 'Detalhe da obra' }}">
    <button type="button" class="nv-resistance-close" data-resistance-close aria-label="{{ 'Close' if lang == 'en' else 'Fechar' }}">×</button>
    <img data-resistance-full alt="">
  </dialog>
</section>

<section class="statement wrap">
  <div class="statement-index" data-reveal><span>{{ "ABOUT THE ARTIST" if lang == "en" else "SOBRE O ARTISTA" }}</span></div>
  <div class="nv-statement-layout"><h2 class="nv-statement-title" data-reveal>{{ "A multidisciplinary practice with a distinct visual language." if lang == "en" else "Uma prática multidisciplinar com linguagem visual própria." }}</h2><div class="nv-statement-content"><p class="statement-text" data-reveal>{{ t.intro }}</p><a class="btn btn--ghost nv-statement-cta" href="{{ aboutUrl | u }}" data-reveal>{{ "EXPLORE THE PRACTICE" if lang == "en" else "CONHEÇA O ARTISTA" }} <span aria-hidden="true">↗</span></a></div></div>
</section>

<section class="sec">
  <div class="head wrap" data-reveal>
    <h2>{{ t.nav_murals }}</h2>
    <a class="more" href="{{ muralsUrl | u }}">{{ t.all_murals }}{% include "chev.svg" %}</a>
  </div>
  <div class="rail" data-rail>
    <div class="rail-track">
      {%- for m in allMurals | top(6) %}
      {{ cards.shot(m, m.slug, lang, (muralsUrl + m.slug + '/') | u, m.images[0] | img(1800)) }}
      {%- endfor %}
    </div>
    <div class="rail-nav wrap" hidden>
      <button class="paddle" type="button" data-dir="-1" aria-label="{{ t.prev }}">{% include "chev.svg" %}</button>
      <button class="paddle" type="button" data-dir="1" aria-label="{{ t.next }}">{% include "chev.svg" %}</button>
    </div>
  </div>
</section>

{%- set scaled = allMurals | toScale(5) %}
{%- if scaled.length > 1 %}
<section class="sec wrap nv-scale-section">
  <div class="tile scale" data-reveal>
    <div class="scale-head">
      <h2>{{ t.scale_title }}</h2>
      <p>{{ t.scale_text }}</p>
    </div>
    <div class="scale-scroll">
      <ol class="scale-list">
        {%- for m in scaled %}
        <li style="--w:{{ m.pct }}%;--ar:{{ m.ar }};--person:{{ m.person }}%;--i:{{ loop.index0 }}">
          <a href="{{ (muralsUrl + m.slug + '/') | u }}">
            <span class="scale-bar"><img src="{{ m.images[0] | img(2000) }}" alt="" loading="lazy" decoding="async" style="object-position:50% {{ m.focus if m.focus is defined else 50 }}%"><svg class="scale-person" viewBox="0 0 10 28" aria-hidden="true"><circle cx="5" cy="3" r="2.7"/><path d="M1 9.4a2.8 2.8 0 0 1 2.8-2.8h2.4A2.8 2.8 0 0 1 9 9.4v7.4H7.5V28h-2v-9h-1v9h-2V16.8H1z"/></svg></span>
            <span class="scale-cap"><span class="scale-name">{{ m.title }}</span><span class="scale-dim">{{ (m.dimensions | replace(',', '.')) if lang == 'en' else m.dimensions }}</span></span>
          </a>
        </li>
        {%- endfor %}
      </ol>
    </div>
  </div>
</section>
{%- endif %}

<section class="sec">
  <div class="head wrap" data-reveal>
    <h2>{{ "Original artworks" if lang == "en" else "Obras autorais" }}</h2>
    <a class="more" href="{{ worksUrl | u }}">{{ t.all_works }}{% include "chev.svg" %}</a>
  </div>
  <div class="bento wrap">
    {%- for w in allWorks | bento %}
    {{ cards.art(w, w.slug, lang, t, (worksUrl + w.slug + '/') | u, w.images[0] | img(1200), 'art--' + w.slot) }}
    {%- endfor %}
  </div>
</section>

{%- set shows = exposicoes | sorted | featured %}
{%- if shows.length %}
<section class="sec wrap">
  <div class="head" data-reveal>
    <h2>{{ t.nav_exhibitions }}</h2>
    <a class="more" href="{{ showsUrl | u }}">{{ t.see_exhibitions }}{% include "chev.svg" %}</a>
  </div>
  <div class="features">
    {%- for e in shows %}
    {{ cards.feature(e, lang, t, (showsUrl + e.slug + '/') | u, e.images[0] | img(1600)) }}
    {%- endfor %}
  </div>
</section>
{%- endif %}

<section class="sec wrap clients">
  <h2 data-reveal>{{ t.clients }}</h2>
  <img class="clients-img" src="{{ site.clients_image | img(2000) }}" alt="{{ site.clients_alt }}" loading="lazy" decoding="async" width="2000" height="957" data-reveal>
</section>

{% include "closing.njk" %}

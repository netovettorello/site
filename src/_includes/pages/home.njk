{%- set t = i18n[lang] -%}
{%- import "cards.njk" as cards -%}
{%- set allMurals = murais | sorted -%}
{%- set allWorks = obras | sorted -%}
{%- set muralsUrl = '/' + lang + '/' + t.path_murals + '/' -%}
{%- set worksUrl = '/' + lang + '/' + t.path_works + '/' -%}
{%- set showsUrl = '/' + lang + '/' + t.path_exhibitions + '/' -%}
<section class="hero nv-hero" aria-label="{{ site.name }}">
  <div class="hero-stick">
    <div class="hero-frame nv-hero-frame">
      <div class="hero-slides">
        {% for h in site.hero %}<img class="hero-media{% if loop.first %} on{% endif %}" src="{{ h.image | img(2400) }}" alt="{{ h.caption }}" data-cap="{{ h.caption }}" {% if loop.first %}fetchpriority="high"{% endif %} decoding="async">{% endfor %}
      </div>
      
      
    </div>
    <div class="nv-hero-layout">
      <div class="nv-top-label">{{ "PORTFÓLIO / 2026" if lang == "pt" else "PORTFOLIO / 2026" }} <span>CURITIBA · INTERNATIONAL</span></div>
      <div class="nv-hero-headline" aria-label="Neto Vettorello"><span class="nv-title-one">Neto</span><span class="nv-title-two">Vettorello</span><span class="nv-hero-profession">{{ "Artista visual · Graffiti, pintura e instalações" if lang == "pt" else "Visual artist · Graffiti, painting & installations" }}</span></div>
      <div class="nv-hero-bottom">
        <div class="nv-hero-index"><span class="nv-index-number">01</span><span class="nv-index-rule"></span><span class="nv-index-total">0{{ site.hero.length }}</span></div>
        <div class="nv-hero-descriptor"><strong>{{ "Obras e projetos selecionados" if lang == "pt" else "Selected art & projects" }}</strong><span>{{ "Brasil · Irlanda · Internacional" if lang == "pt" else "Brazil · Ireland · International" }}</span></div>
        <a href="#nv-curated" class="nv-scroll-cue" aria-label="{{ 'Explorar obras' if lang == 'pt' else 'Explore works' }}">{{ 'DESCOBRIR' if lang == 'pt' else 'DISCOVER' }}<span>↘</span></a>
      </div>
      <div class="nv-slide-mark">{{ site.hero[0].caption }}</div>
    </div>
    <button class="nv-slide-next" type="button" aria-label="Next artwork">NEXT <span>↗</span></button>
  </div>
</section>
<section class="nv-manifesto" aria-label="Artist introduction">
  <span class="nv-micro">{{ "SOBRE A PRÁTICA" if lang == "pt" else "THE PRACTICE" }}</span>
  <div class="nv-manifesto-content"><h2 class="nv-manifesto-copy">{{ "Da rua ao espaço expositivo." if lang == "pt" else "From the street to the exhibition space." }}</h2>
  <p class="nv-manifesto-description">{{ "Uma trajetória entre o graffiti, a pintura e a instalação. Projetos que investigam identidade, território e memória." if lang == "pt" else "A practice across graffiti, painting and installation. Projects exploring identity, territory and memory." }}</p></div>
  <a class="nv-manifesto-link" href="{{ ('/' + lang + '/sobre/') if lang == 'pt' else ('/' + lang + '/about/') }}">{{ "CONHEÇA O ARTISTA" if lang == "pt" else "ABOUT THE ARTIST" }} ↗</a>
</section>
<section class="nv-curated" id="nv-curated" aria-label="Selected visual works">
  <div class="nv-curated-top"><span>[ 002 — SELECTED WORKS ]</span><span>SCROLL TO EXPLORE ↓</span></div>
  <div class="nv-curated-heading"><h2>{{ "Obras selecionadas" if lang == "pt" else "Selected works" }}</h2><p>{{ "Uma seleção de murais, pinturas e instalações." if lang == "pt" else "A selection of murals, paintings and installations." }}</p></div>
  <div class="nv-immersive-rail" data-immersive-rail>
    <a href="{{ muralsUrl | u }}" class="nv-immersive-card"><img src="/img/portal.jpg" alt="The Portal — mural" loading="lazy"><span class="nv-immersive-meta"><b>01 / THE PORTAL</b><small>WATERFORD — 2023</small></span></a>
    <a href="{{ worksUrl | u }}" class="nv-immersive-card"><img src="/img/tani-e.jpg" alt="Tani É" loading="lazy"><span class="nv-immersive-meta"><b>02 / TANI É</b><small>VISUAL LANGUAGE</small></span></a>
    <a href="{{ muralsUrl | u }}" class="nv-immersive-card"><img src="/img/into-the-reef.jpg" alt="Into the Reef" loading="lazy"><span class="nv-immersive-meta"><b>03 / INTO THE REEF</b><small>CORK — 2025</small></span></a>
    <a href="{{ worksUrl | u }}" class="nv-immersive-card"><img src="/img/mestres.jpg" alt="Mestres" loading="lazy"><span class="nv-immersive-meta"><b>04 / MESTRES</b><small>2025</small></span></a>
  </div>
  <div class="nv-rail-footer"><span>DRAG / SCROLL TO NAVIGATE</span><div class="nv-rail-actions"><button type="button" data-nv-prev aria-label="Previous artwork">←</button><button type="button" data-nv-next aria-label="Next artwork">→</button></div></div>
</section>

<section class="statement wrap">
  <div class="statement-index"><span>01 / ARTIST STATEMENT</span><span class="statement-asterisk" aria-hidden="true">✳</span></div>
  <p class="statement-text">{{ t.intro }}</p>
</section>

<section class="sec section-numbered" style="--section-n:'02'">
  <div class="head wrap">
    <h2>{{ t.nav_murals }}</h2>
    <a class="more" href="{{ muralsUrl | u }}">{{ t.all_murals }}{% include "chev.svg" %}</a>
  </div>
  <div class="rail" data-rail>
    <div class="rail-track">
      {%- for m in allMurals | top(6) %}
      {{ cards.shot(m, m.slug, lang, (muralsUrl + m.slug + '/') | u, m.images[0] | img(1800)) }}
      {%- endfor %}
    </div>
    <div class="rail-nav wrap" hidden>
      <button class="paddle" type="button" data-dir="-1" aria-label="{{ t.prev }}">{% include "chev.svg" %}</button>
      <button class="paddle" type="button" data-dir="1" aria-label="{{ t.next }}">{% include "chev.svg" %}</button>
    </div>
  </div>
</section>

{%- set scaled = allMurals | toScale(5) %}
{%- if scaled.length > 1 %}
<section class="sec wrap">
  <div class="tile scale" data-reveal>
    <div class="scale-head">
      <h2>{{ t.scale_title }}</h2>
      <p>{{ t.scale_text }}</p>
    </div>
    <div class="scale-scroll">
      <ol class="scale-list">
        {%- for m in scaled %}
        <li style="--w:{{ m.pct }}%;--ar:{{ m.ar }};--person:{{ m.person }}%;--i:{{ loop.index0 }}">
          <a href="{{ (muralsUrl + m.slug + '/') | u }}">
            <span class="scale-bar"><img src="{{ m.images[0] | img(2000) }}" alt="" loading="lazy" decoding="async" style="object-position:50% {{ m.focus if m.focus is defined else 50 }}%"><svg class="scale-person" viewBox="0 0 10 28" aria-hidden="true"><circle cx="5" cy="3" r="2.7"/><path d="M1 9.4a2.8 2.8 0 0 1 2.8-2.8h2.4A2.8 2.8 0 0 1 9 9.4v7.4H7.5V28h-2v-9h-1v9h-2V16.8H1z"/></svg></span>
            <span class="scale-cap"><span class="scale-name">{{ m.title }}</span><span class="scale-dim">{{ (m.dimensions | replace(',', '.')) if lang == 'en' else m.dimensions }}</span></span>
          </a>
        </li>
        {%- endfor %}
      </ol>
    </div>
  </div>
</section>
{%- endif %}

<section class="sec section-numbered" style="--section-n:'04'">
  <div class="head wrap">
    <h2>{{ t.nav_works }}</h2>
    <a class="more" href="{{ worksUrl | u }}">{{ t.all_works }}{% include "chev.svg" %}</a>
  </div>
  <div class="bento wrap">
    {%- for w in allWorks | bento %}
    {{ cards.art(w, w.slug, lang, t, (worksUrl + w.slug + '/') | u, w.images[0] | img(1200), 'art--' + w.slot) }}
    {%- endfor %}
  </div>
</section>

{%- set shows = exposicoes | sorted | featured %}
{%- if shows.length %}
<section class="sec wrap">
  <div class="head">
    <h2>{{ t.nav_exhibitions }}</h2>
    <a class="more" href="{{ showsUrl | u }}">{{ t.see_exhibitions }}{% include "chev.svg" %}</a>
  </div>
  <div class="features">
    {%- for e in shows %}
    {{ cards.feature(e, lang, t, (showsUrl + e.slug + '/') | u, e.images[0] | img(1600)) }}
    {%- endfor %}
  </div>
</section>
{%- endif %}

<section class="sec wrap clients">
  <h2>{{ t.clients }}</h2>
  <img class="clients-img" src="{{ site.clients_image | img(2000) }}" alt="{{ site.clients_alt }}" loading="lazy" decoding="async" width="2000" height="957" data-reveal>
</section>

{% include "closing.njk" %}
